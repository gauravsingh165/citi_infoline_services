
    <!-- header section strats -->
    <header class="header_section" style="background-color: #b3d3bd;">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="index.html">
            <span>
              CitiInfolineServices
            </span>
          </a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class=""> </span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav  mx-auto ">
              <li class="nav-item active">
                <a class="nav-link" href="index.html">Home <span class="sr-only">(current)</span></a>
              </li>
              <li class="nav-item">
                <%= link_to 'About', home_about_path, class: 'nav-link' %>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="book.html">Appointment</a>
              </li>
                <li class="nav-item">
                    <%= link_to 'Services', home_services_path, class: 'nav-link' %>        
                </li>
            </ul>
            <div class="user_option">
            <%= link_to user_session_path, class: 'nav-link p-0 mr-3 d-inline-flex align-items-center', aria: { label: 'User account' } do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5zm0 2c-4.418 0-8 1.79-8 4v2h16v-2c0-2.21-3.582-4-8-4z"/>
                </svg>
            <% end %>

            <button type="button" class="btn p-0 mr-3 nav_search_icon d-inline-flex align-items-center" aria-label="Search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M21 20l-5.586-5.586A7 7 0 1 0 4 11a7 7 0 0 0 11.414 4.414L20 21l1-1zM11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14z"/>
                </svg>
            </button>
              <form class="form-inline">
                <button class="btn  my-2 my-sm-0 nav_search-btn" type="submit" aria-label="Search">
