<section class="auth-section">
  <div class="auth-overlay" style="background: gainsboro;" ></div>

  <div class="container">
    <div class="row justify-content-center align-items-center">
      <div class="col-md-6 col-lg-5">

        <div class="auth-card">

          <h2>Change your password</h2>
          <p class="subtitle">
            Choose a strong password you don’t reuse anywhere else
          </p>

          <%= form_for(resource,
                as: resource_name,
                url: password_path(resource_name),
                html: { method: :put }) do |f| %>

            <%= render "devise/shared/error_messages", resource: resource %>
            <%= f.hidden_field :reset_password_token %>

            <div class="form-group">
              <%= f.label :password, "New Password" %>
              <% if @minimum_password_length %>
                <small class="hint">
                  Minimum <%= @minimum_password_length %> characters
                </small>
              <% end %>
              <%= f.password_field :password,
                    autofocus: true,
                    autocomplete: "new-password",
                    class: "form-control",
                    placeholder: "Enter new password" %>
            </div>

            <div class="form-group">
              <%= f.label :password_confirmation, "Confirm New Password" %>
              <%= f.password_field :password_confirmation,
                    autocomplete: "new-password",
                    class: "form-control",
                    placeholder: "Confirm new password" %>
            </div>

            <div class="form-group">
              <%= f.submit "Change Password", class: "btn-auth" %>
            </div>

          <% end %>

          <div class="auth-links">
            <%= render "devise/shared/links" %>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<style>

.auth-section {
  min-height: 100vh;
  background: linear-gradient(135deg, #0f172a, #020617);
  display: flex;
  align-items: center;
  position: relative;
}

.auth-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}


.auth-card {
  position: relative;
  background: #ffffff;
  padding: 40px 35px;
  border-radius: 14px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
  z-index: 1;
}

.auth-card h2 {
  font-size: 28px;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6px;
}

.auth-card .subtitle {
  font-size: 14px;
  color: #64748b;
  margin-bottom: 28px;
}

.form-group {
  margin-bottom: 20px;
}

.auth-card label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  margin-bottom: 6px;
}

.auth-card .hint {
  display: block;
  font-size: 12px;
  color: #64748b;
  margin-bottom: 6px;
}

.auth-card .form-control {
  height: 46px;
  width: 100%;
  border-radius: 8px;
  border: 1px solid #cbd5f5;
  font-size: 14px;
  padding: 10px 12px;
  transition: all 0.2s ease;
}

.auth-card .form-control:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}


.btn-auth {
  width: 100%;
  height: 48px;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border: none;
  border-radius: 10px;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
}

.btn-auth:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 25px rgba(37, 99, 235, 0.45);
}

.auth-links {
  text-align: center;
  margin-top: 22px;
}

.auth-links a {
  font-size: 13px;
  color: #2563eb;
  text-decoration: none;
}

.auth-links a:hover {
  text-decoration: underline;
}

#error_explanation {
  background: #fee2e2;
  border: 1px solid #fecaca;
  color: #991b1b;
  padding: 12px 14px;
  border-radius: 8px;
  margin-bottom: 18px;
  font-size: 13px;
}

#error_explanation h2 {
  font-size: 14px;
  margin-bottom: 6px;
}

#error_explanation ul {
  margin: 0;
  padding-left: 18px;
}
</style>
