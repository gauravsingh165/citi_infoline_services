<section class="about_section layout_padding" style="background: white; color: black;">
  <div class="container">

    <div class="row">
      <div class="col-md-6">
        <div class="img-box">
          <%= image_tag 'about-1.jpg', alt: 'Branding and Digital Marketing Agency' %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="detail-box">
          <div class="heading_container">
            <h2>
              We Help Brands Grow Through Smart Marketing
            </h2>
          </div>

          <p>
            We are a results-driven branding and digital marketing agency focused on
            helping businesses build strong brand identities, create impactful content,
            and run effective promotional campaigns.
          </p>

          <p>
            From branding and content creation to digital advertising, social media,
            email marketing, and video services, we provide end-to-end marketing
            solutions that drive visibility, engagement, and real business growth.
          </p>
          <%= link_to 'Book Appointment', home_about_path, class: 'btn1' %>
        </div>
      </div>
    </div>

  </div>
</section>

  <!-- book section -->
  <section class="book_section layout_padding">
    <div class="container">
      <div class="heading_container">
        <h2>
          Book Your Appintment
        </h2>
      </div>
      <div class="row">
        <div class="col-md-6">
          <div class="form_container">
            <%= form_with model: Customer.new, url: customers_path, local: true do |f| %>

              <div>
                <%= f.text_field :name, class: "form-control", placeholder: "Your Name" %>
              </div>

              <div>
                <%= f.text_field :phone, class: "form-control", placeholder: "Phone Number" %>
              </div>

              <div>
                <%= f.email_field :email, class: "form-control", placeholder: "Your Email" %>
              </div>

              <div class="btn_box">
                <%= f.submit "Book Appointment", class: "btn btn-primary" %>
              </div>

            <% end %>

          </div>
        </div>
        <div class="col-md-6">
        <div class="map_container">
        <iframe
          src="https://www.google.com/maps?q=19.171484,73.001678&z=15&output=embed"
          width="100%"
          height="350"
          style="border:0;"
          allowfullscreen
          loading="lazy">
        </iframe>

        </div>

        </div>
      </div>
    </div>
  </section>
  <!-- end book section -->

