
  <div class="hero_area">
    <div class="bg-box">
      <%= image_tag 'bg-1.jpg', alt: '' %>
    </div>
    <!-- end header section -->
    <!-- slider section -->
    <section class="slider_section" >
      <div id="customCarousel1" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">

          <!-- Slide 1 -->
          <div class="carousel-item active">
            <div class="container">
              <div class="row">
                <div class="col-md-7 col-lg-6">
                  <div class="detail-box" style="color: black;" >
                    <h1>
                      Branding & Advertising That Builds Strong Brands
                    </h1>
                    <p>
                      We create powerful branding and advertising strategies that help
                      businesses stand out, connect with their audience, and build
                      long-term brand value.
                    </p>
                    <div class="btn-box">
                      <%= link_to 'Book Appointment', new_customer_path, class: 'btn1' %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="carousel-item">
            <div class="container">
              <div class="row">
                <div class="col-md-7 col-lg-6">
                  <div class="detail-box" style="color: black;">
                    <h1>
                      Content Creation & Strategy That Drives Growth
                    </h1>
                    <p>
                      From content creation and management to content strategy,
                      we deliver consistent, high-quality content that strengthens
                      your brand voice and improves engagement.
                    </p>
                    <div class="btn-box">
                      <%= link_to 'Book Appointment', new_customer_path, class: 'btn1' %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 3 -->
          <div class="carousel-item">
            <div class="container">
              <div class="row">
                <div class="col-md-7 col-lg-6">
                  <div class="detail-box" style="color: black;">
                    <h1>
                      Digital Marketing That Delivers Real Results
                    </h1>
                    <p>
                      We specialize in digital advertising, social media marketing,
                      email marketing, and content marketing to increase visibility,
                      leads, and conversions.
                    </p>
                    <div class="btn-box">
                      <%= link_to 'Book Appointment', new_customer_path, class: 'btn1' %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Indicators -->
        <div class="container">
          <ol class="carousel-indicators">
            <li data-target="#customCarousel1" data-slide-to="0" class="active"></li>
            <li data-target="#customCarousel1" data-slide-to="1"></li>
            <li data-target="#customCarousel1" data-slide-to="2"></li>
          </ol>
        </div>
      </div>
    </section>
    <!-- end slider section -->

  </div>

<section class="about_section layout_padding" style="background: white; color: black;">
  <div class="container">

    <div class="row">
      <div class="col-md-6">
        <div class="img-box">
          <%= image_tag 'about-1.jpg', alt: 'Branding and Digital Marketing Agency' %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="detail-box">
          <div class="heading_container">
            <h2>
              We Help Brands Grow Through Smart Marketing
            </h2>
          </div>

          <p>
            We are a results-driven branding and digital marketing agency focused on
            helping businesses build strong brand identities, create impactful content,
            and run effective promotional campaigns.
          </p>

          <p>
            From branding and content creation to digital advertising, social media,
            email marketing, and video services, we provide end-to-end marketing
            solutions that drive visibility, engagement, and real business growth.
          </p>
          <%= link_to 'Book Appointment', home_about_path, class: 'btn1' %>
        </div>
      </div>
    </div>

  </div>
</section>

  <!-- book section -->
  <section class="book_section layout_padding">
    <div class="container">
      <div class="heading_container">
        <h2>
          Book Your Appintment
        </h2>
      </div>
      <div class="row">
        <div class="col-md-6">
          <div class="form_container">
            <%= form_with model: Customer.new, url: customers_path, local: true do |f| %>

              <div>
                <%= f.text_field :name, class: "form-control", placeholder: "Your Name" %>
              </div>

              <div>
                <%= f.text_field :phone, class: "form-control", placeholder: "Phone Number" %>
              </div>

              <div>
                <%= f.email_field :email, class: "form-control", placeholder: "Your Email" %>
              </div>

              <div class="btn_box">
                <%= f.submit "Book Appointment", class: "btn btn-primary" %>
              </div>

            <% end %>

          </div>
        </div>
        <div class="col-md-6">
        <div class="map_container">
        <iframe
          src="https://www.google.com/maps?q=19.171484,73.001678&z=15&output=embed"
          width="100%"
          height="350"
          style="border:0;"
          allowfullscreen
          loading="lazy">
        </iframe>

        </div>

        </div>
      </div>
    </div>
  </section>
