<section class="hero_section">
  <div id="heroCarousel" class="carousel slide" data-ride="carousel">

    <div class="carousel-inner">

      <!-- Slide 1 -->
      <div class="carousel-item active">

        <!-- Image section -->
        <div class="hero-image">
          <%= image_tag 'branding-3-1.jpg', class: 'img-fluid w-100' %>
        </div>

        <!-- Text section -->
        <div class="hero-text">
          <div class="container">
            <div class="col-md-7">
              <h1>Branding & Advertising That Builds Strong Brands</h1>
              <p>
                We create powerful branding strategies that help businesses stand out.
              </p>
              <%= link_to 'Book Appointment', new_customer_path, class: 'btn1' %>
            </div>
          </div>
        </div>

      </div>

      <!-- Slide 2 -->
      <div class="carousel-item">

        <div class="hero-image">
          <%= image_tag 'product.jpg', class: 'img-fluid w-100' %>
        </div>

        <div class="hero-text">
          <div class="container">
            <div class="col-md-7">
              <h1>Content Creation & Strategy That Drives Growth</h1>
              <p>
                High-quality content that strengthens your brand voice.
              </p>
              <%= link_to 'Book Appointment', new_customer_path, class: 'btn1' %>
            </div>
          </div>
        </div>

      </div>

      <!-- Slide 3 -->
      <div class="carousel-item">

        <div class="hero-image">
          <%= image_tag 'bg-3.jpg', class: 'img-fluid w-100' %>
        </div>

        <div class="hero-text">
          <div class="container">
            <div class="col-md-7">
              <h1>Digital Marketing That Delivers Real Results</h1>
              <p>
                Visibility, leads, and conversions through digital marketing.
              </p>
              <%= link_to 'Book Appointment', new_customer_path, class: 'btn1' %>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>



<section class="about_section layout_padding" style="background: white; color: black;">
  <div class="container">

    <div class="row">
      <div class="col-md-6">
        <div class="img-box">
          <%= image_tag 'about-1.jpg', alt: 'Branding and Digital Marketing Agency' %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="detail-box">
          <div class="heading_container">
            <h2>
              We Help Brands Grow Through Smart Marketing
            </h2>
          </div>

          <p>
            We are a results-driven branding and digital marketing agency focused on
            helping businesses build strong brand identities, create impactful content,
            and run effective promotional campaigns.
          </p>

          <p>
            From branding and content creation to digital advertising, social media,
            email marketing, and video services, we provide end-to-end marketing
            solutions that drive visibility, engagement, and real business growth.
          </p>
          <%= link_to 'Book Appointment', home_about_path, class: 'btn1' %>
        </div>
      </div>
    </div>

  </div>
</section>

  <!-- book section -->
  <section class="book_section layout_padding">
    <div class="container">
      <div class="heading_container">
        <h2>
          Book Your Appintment
        </h2>
      </div>
      <div class="row">
        <div class="col-md-6">
          <div class="form_container">
            <%= form_with model: Customer.new, url: customers_path, local: true do |f| %>

              <div>
                <%= f.text_field :name, class: "form-control", placeholder: "Your Name" %>
              </div>

              <div>
                <%= f.text_field :phone, class: "form-control", placeholder: "Phone Number" %>
              </div>

              <div>
                <%= f.email_field :email, class: "form-control", placeholder: "Your Email" %>
              </div>

              <div class="btn_box">
                <%= f.submit "Book Appointment", class: "btn btn-primary" %>
              </div>

            <% end %>

          </div>
        </div>
        <div class="col-md-6">
        <div class="map_container">
        <iframe
          src="https://www.google.com/maps?q=19.171484,73.001678&z=15&output=embed"
          width="100%"
          height="350"
          style="border:0;"
          allowfullscreen
          loading="lazy">
        </iframe>

        </div>

        </div>
      </div>
    </div>
  </section>
<style>
.hero-image img {
  height: 47vh;
  object-fit: cover;
}

.hero-text {
  padding: 118px 0;
  background: linear-gradient(135deg, #ad8754 0%, #caa86a 100%);
  color: #fff;
}
.hero-text h1,
.hero-text p {
  color: #fff;
  text-shadow: 0 1px 2px rgba(0,0,0,0.25);
}

.btn1 {
  display: inline-block;
  background: linear-gradient(180deg,#f7d76b 0%, #efc33e 100%);
  color: #1a1a1a;
  padding: 12px 26px;
  border: none;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 700;
  letter-spacing: 0.2px;
  box-shadow: 0 6px 18px rgba(239,195,62,0.24);
  transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
  cursor: pointer;
  -webkit-appearance: none;
  -moz-appearance: none;
}

.btn1:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(239,195,62,0.30);
  filter: brightness(1.03);
}
.btn1:active {
  transform: translateY(-1px);
}
.btn1:focus {
  outline: 3px solid rgba(255,230,150,0.6);
  outline-offset: 3px;
  box-shadow: 0 0 0 6px rgba(239,195,62,0.12);
}

@media (max-width: 576px) {
  .hero-text { padding: 48px 0; }
  .btn1 { padding: 10px 18px; font-size: 15px; }
}

</style>